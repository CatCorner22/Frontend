"/* Design values of one Refraction project. Use each value by its name; do not copy a raw value into a component. Fingerprint: f30f6959. */
:root {
  --bg: #f7faff;
  --surface: #ffffff;
  --surface-2: #e9f1fb;
  --card-surface: #ffffff;
  --border-strong: #646e7c;
  --text: #09111c;
  --text-muted: #4e5967;
  --accent: #0f4ea3;
  --on-accent: #fafcff;
  --accent-text: #0f4ea3;
  --accent-soft: #e2eeff;
  --accent-2: #0f4ea3;
  --on-accent-2: #fafcff;
  --action: #0f4ea3;
  --on-action: #fafcff;
  --btn-label: #fafcff;
  --btn-fill: #0f4ea3;
  --band-bg: #e2eeff;
  --band-text: #09111c;
  --band-solid-bg: #0f4ea3;
  --band-solid-text: #fafcff;
  --hero-bg: #f7faff;
  --hero-text: #09111c;
  --focus: #0f4ea3;
  --focus-hero: #0f4ea3;
  --marker-ink: #0f4ea3;
  --border: rgb(9 17 28 / 0.148);
  --selection: rgb(15 78 163 / 0.22);
  --marker: rgb(15 78 163 / 0.3);
  --soft-label-alpha: 0.78;
  --hero-lede-alpha: 0.88;
  --display-scale: 1;
  --media-a: #e2eeff;
  --media-b: #e9f1fb;
  --inset-highlight: rgb(255 255 255 / 0.8);
  --recess: rgb(0 0 0 / 0.045);
  --card-backdrop: none;
  --header-bg: #f7faff;
  --header-backdrop: none;
  --header-position: static;
  --page-atmo: none;
  --card-bg: #ffffff;
  --card-border: rgb(9 17 28 / 0.148);
  --card-border-w: 1px;
  --card-shadow: none;
  --control-shadow: none;
  --btn-bg: #0f4ea3;
  --btn-bg-hover: #2460b7;
  --btn-color: #fafcff;
  --btn-border: #004091;
  --btn-shadow: var(--control-shadow);
  --btn-shadow-hover: var(--control-shadow);
  --atmo-image: none;
  --atmo-size: auto;
  --atmo-mask: none;
  --grain-opacity: 0;
  --display-fill: none;
  --dur-fast: 120ms;
  --dur: 200ms;
  --dur-slow: 480ms;
  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
  --press-scale: 0.97;
  --hover-lift: 0px;
  --text-xs: 0.8287rem;
  --text-sm: 0.9456rem;
  --text-base: 1.0625rem;
  --text-lg: 1.3281rem;
  --text-xl: 1.6602rem;
  --text-2xl: 2.0752rem;
  --text-3xl: 2.594rem;
  --text-4xl: 3.2425rem;
  --text-display: clamp(2.0752rem, 1.5915rem + 2.064vw, 3.2425rem);
  --lede-size: min(var(--text-lg), 5.6vw);
  --h2-size: min(var(--text-2xl), 8.5vw);
  --h3-size: min(var(--text-xl), 7vw);
  --numeral-size: min(var(--text-3xl), 11vw);
  --brand-size: min(var(--text-lg), 6vw);
  --h1-floor: max(calc(var(--lede-size) * 1.25), calc(var(--h2-size) * 1.15));
  --font-heading: "Public Sans Variable", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-body: "Public Sans Variable", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-mono: "JetBrains Mono Variable", ui-monospace, monospace;
  --heading-weight: 600;
  --heading-tracking: -0.015em;
  --heading-transform: none;
  --leading-heading: 1.12;
  --leading-body: 1.55;
  --numeric: tabular-nums;
  --font-numeric: inherit;
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;
  --space-16: 4rem;
  --space-20: 5rem;
  --space-24: 6rem;
  --space-32: 8rem;
  --section-gap: 6.5rem;
  --page-max: 68rem;
  --measure: 65ch;
  --about-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  --fees-column: auto;
  --radius-control: 8px;
  --radius-surface: 12px;
  --radius-small: 4px;
  --border-w: 1px;
  --control-border-w: 1px;
  --focus-w: 3px;
  --target-min: 2.75rem;
}
"
