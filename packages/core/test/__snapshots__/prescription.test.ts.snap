"{
  "$description": "Design values of one Refraction project, in the Design Tokens format. tokens.css holds the same values as CSS custom properties; the name there is the name here with two leading dashes.",
  "color": {
    "$description": "Colors, as they are drawn: red, green, and blue as shares of 1, with the six digits as a fallback.",
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9686,
          0.9804,
          1
        ],
        "hex": "#f7faff"
      }
    },
    "surface": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "surface-2": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9137,
          0.9451,
          0.9843
        ],
        "hex": "#e9f1fb"
