    }
  },
  "curve": {
    "$description": "How a change speeds up and settles.",
    "ease-out": {
      "$type": "cubicBezier",
      "$value": [
        0.23,
        1,
        0.32,
        1
      ]
    },
    "ease-in-out": {
      "$type": "cubicBezier",
      "$value": [
        0.77,
        0,
        0.175,
        1
      ]
    }
  },
  "typeface": {
    "$description": "Typefaces, most wanted first; the later names are fallbacks that every device has.",
    "font-heading": {
      "$type": "fontFamily",
      "$value": [
        "Fraunces Variable",
        "Georgia",
        "Times New Roman",
        "serif"
      ]
    },
    "font-body": {
      "$type": "fontFamily",
      "$value": [
        "Public Sans Variable",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "sans-serif"
      ]
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono Variable",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "$extensions": {
    "refraction.fingerprint": "7776d35d",
    "refraction.css-only": {
      "note": "Values for which the Design Tokens format has no type (a shadow or a gradient written as CSS, a size that grows with the window, a keyword). They are CSS values, by their CSS names; they are not tokens of the format.",
      "values": {
        "--card-backdrop": "none",
        "--header-backdrop": "none",
        "--header-position": "static",
        "--page-atmo": "none",
        "--card-shadow": "none",
        "--control-shadow": "none",
        "--btn-shadow": "var(--control-shadow)",
        "--btn-shadow-hover": "var(--control-shadow)",
        "--atmo-image": "none",
        "--atmo-size": "auto",
        "--atmo-mask": "none",
        "--display-fill": "none",
        "--text-display": "clamp(2.0752rem, 1.5915rem + 2.064vw, 3.2425rem)",
        "--lede-size": "min(var(--text-lg), 5.6vw)",
        "--h2-size": "min(var(--text-2xl), 8.5vw)",
        "--h3-size": "min(var(--text-xl), 7vw)",
        "--numeral-size": "min(var(--text-3xl), 11vw)",
        "--brand-size": "min(var(--text-lg), 6vw)",
        "--h1-floor": "max(calc(var(--lede-size) * 1.25), calc(var(--h2-size) * 1.15))",
        "--heading-tracking": "-0.015em",
        "--heading-transform": "none",
        "--numeric": "tabular-nums",
        "--font-numeric": "inherit",
        "--measure": "65ch",
        "--about-columns": "minmax(0, 1.1fr) minmax(0, 0.9fr)",
        "--fees-column": "auto"
      }
    }
  }
}
