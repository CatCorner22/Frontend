{
  "name": "refraction",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p apps/studio",
    "lint": "eslint . --max-warnings 0",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "build": "npm run build -w @refraction/studio",
    "dev": "npm run dev -w @refraction/studio",
    "check": "npm run typecheck && npm run lint && npm run boundaries && npm run test"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
